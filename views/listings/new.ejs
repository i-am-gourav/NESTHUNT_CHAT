<% layout("/layouts/boilerplate") %>

<div class="row">
    <div class="col-8 offset-2">

        <h3 class="new-listing-heading">Create a New Listing</h3>

        <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">

            <!-- Title -->
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input
                    type="text"
                    name="listing[title]"
                    id="title"
                    placeholder="Enter listing title"
                    class="form-control"
                    required
                >
                <div class="valid-feedback">
                    Looks good!
                </div>
                <div class="invalid-feedback">
                    Please enter a title.
                </div>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea
                    name="listing[description]"
                    id="description"
                    placeholder="Describe your property"
                    class="form-control"
                    rows="5"
                    required
                ></textarea>
                <div class="valid-feedback">
                    Looks good!
                </div>
                <div class="invalid-feedback">
                    Please enter a description.
                </div>
            </div>

            <!-- Image Upload -->
            <div class="mb-3">
                <label for="image" class="form-label">Upload Listing Image</label>
                <input
                    type="file"
                    name="listing[image]"
                    id="image"
                    class="form-control"
                    required
                >
                <div class="invalid-feedback">
                    Please upload an image.
                </div>
            </div>

            <!-- Price & Category Row -->
            <div class="row">
                <div class="mb-3 col-md-6">
                    <label for="price" class="form-label">Price</label>
                    <input
                        type="number"
                        name="listing[price]"
                        id="price"
                        placeholder="Enter price per night"
                        class="form-control"
                        required
                        min="1"
                    >
                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    <div class="invalid-feedback">
                        Please enter a valid price.
                    </div>
                </div>

                <div class="mb-3 col-md-6">
                    <label for="category" class="form-label">Category</label>
                    <select name="listing[category]" id="category" class="form-select">
                        <option value="Trending" selected>Trending</option>
                        <option value="Rooms">Rooms</option>
                        <option value="Iconic Cities">Iconic Cities</option>
                        <option value="Mountains">Mountains</option>
                        <option value="Castles">Castles</option>
                        <option value="Amazing Pools">Amazing Pools</option>
                        <option value="Camping">Camping</option>
                        <option value="Farms">Farms</option>
                        <option value="Arctic">Arctic</option>
                        <option value="Domes">Domes</option>
                        <option value="Boats">Boats</option>
                        <option value="Beachfront">Beachfront</option>
                    </select>
                </div>
            </div>

            <!-- Location -->
            <div class="mb-3">
                <label for="location" class="form-label">Location</label>
                <input
                    type="text"
                    name="listing[location]"
                    id="location"
                    placeholder="Enter location"
                    class="form-control"
                    required
                >
                <div class="valid-feedback">
                    Looks good!
                </div>
                <div class="invalid-feedback">
                    Please enter a location.
                </div>
            </div>

            <!-- Country -->
            <div class="mb-3">
                <label for="country" class="form-label">Country</label>
                <input
                    type="text"
                    name="listing[country]"
                    id="country"
                    placeholder="Enter country"
                    class="form-control"
                    required
                >
                <div class="valid-feedback">
                    Looks good!
                </div>
                <div class="invalid-feedback">
                    Please enter a country.
                </div>
            </div>

            <button class="btn btn-dark add-btn">
                Add Listing
            </button>

        </form>

    </div>
</div>