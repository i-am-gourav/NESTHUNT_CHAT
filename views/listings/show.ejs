<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
    <div class="col-8 offset-2">

        <h3 class="show-heading">
            <%= listing.title %>
        </h3>

        <!-- Listing Image -->
        <div class="show-image-container">
            <img
                src="<%= listing.image.url %>"
                class="show-image"
                alt="<%= listing.title %>"
            >
        </div>

        <!-- Listing Details -->
        <div class="show-details">

            <p class="show-location">
                <%= listing.location %>, <%= listing.country %>
            </p>

            <p class="text-muted">
                Owned by <i><%= listing.owner ? listing.owner.username : 'NestHunt Host' %></i>
            </p>

            <p class="show-price">
                ₹<%= listing.price.toLocaleString("en-IN") %>
                <span> / night</span>
            </p>

            <p class="show-description">
                <%= listing.description %>
            </p>

        </div>

        <!-- Buttons -->
        <% if (currentUser && listing.owner && listing.owner._id.equals(currentUser._id)) { %>
            <div class="show-actions">

                <a
                    href="/listings/<%= listing._id %>/edit"
                    class="btn btn-dark"
                >
                    Edit
                </a>

                <form
                    method="POST"
                    action="/listings/<%= listing._id %>?_method=DELETE"
                >
                    <button class="btn btn-outline-danger">
                        Delete
                    </button>
                </form>

            </div>
        <% } %>


        <!-- Review Section -->
        <hr class="my-4">

        <% if (currentUser) { %>
            <h4>Leave a Review</h4>

            <form
                action="/listings/<%= listing._id %>/reviews"
                method="POST"
            >

                <!-- Rating (Slot Machine Pattern) -->
                <div class="mb-3">
                    <label for="rating" class="form-label fw-semibold">
                        Rating
                    </label>
                    <fieldset class="starability-slot">
                        <input
                            type="radio"
                            id="no-rate"
                            class="input-no-rate"
                            name="review[rating]"
                            value="1"
                            checked
                            aria-label="No rating."
                        />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>

                <!-- Comment -->
                <div class="mb-3">
                    <label for="comment" class="form-label">
                        Comment
                    </label>

                    <textarea
                        name="review[comment]"
                        id="comment"
                        rows="4"
                        class="form-control"
                        required
                    ></textarea>
                </div>

                <button class="btn btn-outline-dark">
                    Submit Review
                </button>

            </form>
        <% } else { %>
            <div class="alert alert-light border my-3">
                <a href="/login" class="fw-bold text-dark">Log in</a> or <a href="/signup" class="fw-bold text-dark">sign up</a> to leave a review.
            </div>
        <% } %>


        <!-- All Reviews -->
        <% if (listing.reviews && listing.reviews.length > 0) { %>
            <hr class="my-4">

            <h4>All Reviews</h4>

            <div class="row">

                <% for(let review of listing.reviews) { %>

                    <div class="col-md-6 mb-3">

                        <div class="card h-100">

                            <div class="card-body d-flex flex-column justify-content-between">

                                <div>
                                    <h6 class="card-subtitle mb-2 text-muted fw-bold">
                                        <i class="fa-regular fa-user me-1"></i><%= review.author ? review.author.username : 'Anonymous' %>
                                    </h6>

                                    <p class="starability-result card-text mb-2" data-rating="<%= review.rating %>">
                                        Rated: <%= review.rating %> stars
                                    </p>

                                    <p class="card-text">
                                        <%= review.comment %>
                                    </p>
                                </div>

                                <% if (currentUser && review.author && review.author._id.equals(currentUser._id)) { %>
                                    <form
                                        method="POST"
                                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                        class="mt-2"
                                    >
                                        <button class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </button>
                                    </form>
                                <% } %>

                            </div>

                        </div>

                    </div>

                <% } %>

            </div>
        <% } %>

        <!-- Map Section -->
        <hr class="my-4">
        <div class="col-12 mb-4">
            <h4 class="mb-3">Where you'll be</h4>
            <div id="map"></div>
        </div>

    </div>
</div>

<script>
    const mapToken = "<%= process.env.MAP_TOKEN || mapToken || '' %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>
<script src="/Js/map.js"></script>