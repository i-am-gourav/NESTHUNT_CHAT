<% layout("/layouts/boilerplate") %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Confirmation Card -->
            <div class="card border-0 shadow rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-success text-white text-center py-4">
                    <div class="mb-3">
                        <i class="fa-solid fa-circle-check fa-4x text-white"></i>
                    </div>
                    <h2 class="fw-bold mb-1">Booking Confirmed!</h2>
                    <p class="mb-0 text-white-50">Thank you! Your payment was verified and your reservation is secured.</p>
                </div>

                <div class="card-body p-4 p-md-5">
                    <!-- Transaction Overview Pills -->
                    <div class="row g-3 text-center mb-4 pb-3 border-bottom">
                        <div class="col-sm-4">
                            <span class="text-muted small d-block">Razorpay Order ID</span>
                            <strong class="text-dark small text-break"><%= orderId %></strong>
                        </div>
                        <div class="col-sm-4">
                            <span class="text-muted small d-block">Payment ID</span>
                            <strong class="text-success small text-break"><%= paymentDetails.paymentId || "Captured" %></strong>
                        </div>
                        <div class="col-sm-4">
                            <span class="text-muted small d-block">Payment Status</span>
                            <span class="badge bg-success-subtle text-success border border-success px-3 py-1 rounded-pill">
                                <i class="fa-solid fa-check me-1"></i>PAID
                            </span>
                        </div>
                    </div>

                    <!-- Booked Properties List -->
                    <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-house-chimney text-danger"></i>
                        <span>Reserved Stays</span>
                    </h5>

                    <div class="d-flex flex-column gap-3 mb-4">
                        <% for (let item of bookings) { %>
                            <div class="card border rounded-3 p-3 bg-light">
                                <div class="row g-3 align-items-center">
                                    <div class="col-md-3">
                                        <img 
                                            src="<%= item.listing && item.listing.image ? item.listing.image.url : '/images/placeholder.jpg' %>" 
                                            class="img-fluid rounded-3 object-fit-cover w-100" 
                                            style="height: 90px;"
                                            alt="<%= item.listing ? item.listing.title : 'Listing' %>"
                                        />
                                    </div>
                                    <div class="col-md-6">
                                        <h6 class="fw-bold mb-1 text-truncate">
                                            <%= item.listing ? item.listing.title : 'Property' %>
                                        </h6>
                                        <p class="text-muted small mb-1">
                                            <i class="fa-solid fa-location-dot text-danger me-1"></i>
                                            <%= item.listing ? item.listing.location : '' %>, <%= item.listing ? item.listing.country : '' %>
                                        </p>
                                        <div class="small text-muted">
                                            <span>
                                                <strong>Check-in:</strong> 
                                                <%= new Date(item.checkIn).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) %>
                                            </span>
                                            <span class="mx-2">•</span>
                                            <span>
                                                <strong>Check-out:</strong> 
                                                <%= new Date(item.checkOut).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) %>
                                            </span>
                                            <span class="badge bg-secondary ms-2"><%= item.numberOfDays %> nights</span>
                                        </div>
                                    </div>
                                    <div class="col-md-3 text-md-end">
                                        <span class="text-muted small d-block">Amount</span>
                                        <span class="fs-5 fw-bold text-dark">₹<%= item.totalAmount.toLocaleString("en-IN") %></span>
                                    </div>
                                </div>
                            </div>
                        <% } %>
                    </div>

                    <!-- Payment Summary Box -->
                    <div class="p-3 bg-white border rounded-3 shadow-sm mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="text-muted small d-block">Method</span>
                                <span class="fw-semibold text-dark text-capitalize">
                                    <i class="fa-solid fa-credit-card text-primary me-1"></i>Razorpay Gateway
                                </span>
                            </div>
                            <div class="text-end">
                                <span class="text-muted small d-block">Total Paid</span>
                                <span class="fs-4 fw-bold text-success">₹<%= totalPaid.toLocaleString("en-IN") %></span>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-3">
                        <a href="/bookings" class="btn btn-dark rounded-pill px-4 py-2 fw-semibold">
                            <i class="fa-solid fa-calendar-days me-2"></i>View All My Bookings
                        </a>
                        <a href="/listings" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                            <i class="fa-solid fa-compass me-2"></i>Explore More Stays
                        </a>
                        <button onclick="window.print()" class="btn btn-light border rounded-pill px-4 py-2 fw-semibold">
                            <i class="fa-solid fa-print me-2"></i>Print Receipt
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

