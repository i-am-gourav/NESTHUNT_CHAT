<% layout("/layouts/boilerplate") %>

<div class="container py-4 my-3">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
                <i class="fa-solid fa-calendar-check text-success"></i>
                <span>My Bookings</span>
            </h2>
            <p class="text-muted small mb-0">Track your verified reservations and payment statuses</p>
        </div>
        <a href="/cart" class="btn btn-outline-danger rounded-pill px-3 py-2 btn-sm fw-semibold">
            <i class="fa-solid fa-cart-shopping me-1"></i>Cart
        </a>
    </div>

    <% if (!bookings || bookings.length === 0) { %>
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center my-4 bg-light">
            <div class="mb-3">
                <i class="fa-regular fa-calendar-xmark fa-4x text-muted opacity-50"></i>
            </div>
            <h4 class="fw-bold mb-2">No Bookings Found</h4>
            <p class="text-muted mb-4">You have not reserved any stays yet. Explore our curated properties and book your next getaway!</p>
            <div>
                <a href="/listings" class="btn btn-danger px-4 py-2 rounded-pill fw-semibold shadow-sm">
                    <i class="fa-solid fa-compass me-2"></i>Browse Stays
                </a>
            </div>
        </div>
    <% } else { %>
        <div class="row g-4">
            <% for (let booking of bookings) { %>
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                        <div class="row g-0 h-100">
                            <!-- Image -->
                            <div class="col-sm-5 position-relative">
                                <img 
                                    src="<%= booking.listing && booking.listing.image ? booking.listing.image.url : '/images/placeholder.jpg' %>" 
                                    class="img-fluid w-100 h-100 object-fit-cover" 
                                    style="min-height: 200px;"
                                    alt="<%= booking.listing ? booking.listing.title : 'Stay' %>"
                                />
                                <span class="badge <%= booking.status === 'confirmed' ? 'bg-success' : 'bg-warning text-dark' %> position-absolute top-0 start-0 m-2 px-3 py-1 rounded-pill shadow-sm">
                                    <i class="fa-solid <%= booking.status === 'confirmed' ? 'fa-circle-check' : 'fa-clock' %> me-1"></i>
                                    <%= booking.status.toUpperCase() %>
                                </span>
                            </div>

                            <!-- Content -->
                            <div class="col-sm-7 p-3 p-md-4 d-flex flex-column justify-content-between">
                                <div>
                                    <h5 class="fw-bold mb-1 text-truncate">
                                        <a href="/listings/<%= booking.listing ? booking.listing._id : '' %>" class="text-decoration-none text-dark hover-underline">
                                            <%= booking.listing ? booking.listing.title : 'Reserved Stay' %>
                                        </a>
                                    </h5>
                                    <p class="text-muted small mb-3">
                                        <i class="fa-solid fa-location-dot text-danger me-1"></i>
                                        <%= booking.listing ? booking.listing.location : '' %>, <%= booking.listing ? booking.listing.country : '' %>
                                    </p>

                                    <!-- Dates -->
                                    <div class="bg-light p-2 rounded-3 small mb-3">
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">Check-in:</span>
                                            <strong class="text-dark">
                                                <%= new Date(booking.checkIn).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) %>
                                            </strong>
                                        </div>
                                        <div class="d-flex justify-content-between mb-1">
                                            <span class="text-muted">Check-out:</span>
                                            <strong class="text-dark">
                                                <%= new Date(booking.checkOut).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) %>
                                            </strong>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span class="text-muted">Duration:</span>
                                            <span class="badge bg-secondary rounded-pill"><%= booking.numberOfDays %> nights</span>
                                        </div>
                                    </div>
                                </div>

                                <div>
                                    <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                        <div>
                                            <span class="text-muted small d-block">Total Paid</span>
                                            <span class="fs-5 fw-bold text-success">₹<%= booking.totalAmount.toLocaleString("en-IN") %></span>
                                        </div>
                                        <% if (booking.payment && booking.payment.orderId) { %>
                                            <a href="/payment/success/<%= booking.payment.orderId %>" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                                <i class="fa-solid fa-receipt me-1"></i>Receipt
                                            </a>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
    <% } %>
</div>

